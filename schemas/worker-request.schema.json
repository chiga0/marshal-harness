{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.dev/schemas/v1alpha1/worker-request.schema.json",
  "title": "Marshal WorkerRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "taskId",
    "runId",
    "attemptId",
    "attemptNumber",
    "specDigest",
    "policyDigest",
    "capabilityDigest",
    "agentRegistrationId",
    "agentCapabilitySnapshotDigest",
    "baseSha",
    "worktreePath",
    "controlRoot",
    "taskSpecPath",
    "promptPath",
    "resultPath",
    "adapterId",
    "executionProfile",
    "sessionPolicy",
    "attemptTimeoutSeconds",
    "maxOutputBytes",
    "reviewFindings"
  ],
  "properties": {
    "apiVersion": { "const": "marshal.dev/v1alpha1" },
    "kind": { "const": "WorkerRequest" },
    "taskId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "attemptId": { "$ref": "#/$defs/id" },
    "attemptNumber": { "type": "integer", "minimum": 1 },
    "previousAttemptId": { "$ref": "#/$defs/id" },
    "specDigest": { "$ref": "#/$defs/digest" },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "capabilityDigest": { "$ref": "#/$defs/digest" },
    "agentRegistrationId": {
      "type": "string",
      "pattern": "^registration:[0-9a-f]{8,64}$",
      "description": "稳定 capability identity 派生的精确 agent registration id；production launch 前必须存在，接纳端对其做 exact lookup。"
    },
    "agentCapabilitySnapshotDigest": {
      "$ref": "#/$defs/digest",
      "description": "排除 probedAt 后的稳定 agent authority snapshot digest；与完整 capabilityDigest 分离，production launch 前必须冻结。"
    },
    "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "worktreePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "controlRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "taskSpecPath": { "$ref": "#/$defs/relativePath" },
    "promptPath": { "$ref": "#/$defs/relativePath" },
    "resultPath": { "$ref": "#/$defs/relativePath" },
    "adapterId": { "$ref": "#/$defs/id" },
    "executionProfile": {
      "type": "string",
      "enum": ["read-only", "workspace-write", "hardened"]
    },
    "sessionPolicy": {
      "type": "string",
      "enum": ["ephemeral", "persist", "resume"]
    },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "attemptTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 10000000000 },
    "reviewFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "description", "requiredOutcome"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "requiredOutcome": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "localSelfIdentityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "selfProfile", "activationDigest", "identitySubjectDigest", "dispatchObservationDigest"],
      "properties": {
        "schemaVersion": { "const": "marshal.local-self-identity-binding.v1" },
        "selfProfile": { "const": "darwin-local-dogfood" },
        "activationDigest": { "$ref": "#/$defs/digest" },
        "identitySubjectDigest": { "$ref": "#/$defs/digest" },
        "dispatchObservationDigest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:[\\\\/]" },
          { "pattern": "(^|/)\\.\\.(/|$)" },
          { "pattern": "\\\\" },
          { "pattern": "\\u0000" }
        ]
      }
    }
  }
}
