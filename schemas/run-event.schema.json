{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.dev/schemas/v1alpha1/run-event.schema.json",
  "title": "Marshal RunEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "eventId",
    "runId",
    "sequence",
    "type",
    "timestamp",
    "payload"
  ],
  "properties": {
    "apiVersion": { "const": "marshal.dev/v1alpha1" },
    "kind": { "const": "RunEvent" },
    "eventId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "attemptId": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "stateFrom": { "$ref": "#/$defs/state" },
    "stateTo": { "$ref": "#/$defs/state" },
    "timestamp": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["system", "lead-agent", "worker", "human", "publisher"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "payload": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "worker.stopped" } }, "required": ["type"] },
      "then": {
        "required": ["attemptId", "actor", "stateFrom", "stateTo"],
        "properties": {
          "stateFrom": { "const": "RUNNING" },
          "stateTo": { "const": "BLOCKED" },
          "actor": { "properties": { "type": { "const": "system" }, "id": { "const": "marshal-core" } } },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stopIntentDigest", "stopRequestDigest", "originalRunAuthorityHead", "terminalizationBarrierFactDigest", "processTerminalFactDigest", "allocationTerminatedFactDigest", "supervisorClosedFactDigest", "cleanupReleasedFactDigest", "terminalReason"],
            "properties": {
              "stopIntentDigest": { "$ref": "#/$defs/stopDigest" },
              "stopRequestDigest": { "$ref": "#/$defs/stopDigest" },
              "originalRunAuthorityHead": { "$ref": "#/$defs/stopDigest" },
              "terminalizationBarrierFactDigest": { "$ref": "#/$defs/stopDigest" },
              "processTerminalFactDigest": { "$ref": "#/$defs/stopDigest" },
              "allocationTerminatedFactDigest": { "$ref": "#/$defs/stopDigest" },
              "supervisorClosedFactDigest": { "$ref": "#/$defs/stopDigest" },
              "cleanupReleasedFactDigest": { "$ref": "#/$defs/stopDigest" },
              "terminalReason": { "enum": ["aborted-by-operator", "attempt-deadline-exceeded", "run-deadline-exceeded"] }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stopDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "state": {
      "type": "string",
      "enum": [
        "CREATED",
        "PLANNED",
        "READY",
        "RUNNING",
        "RETRY_PENDING",
        "VERIFYING",
        "REVIEW_PENDING",
        "REWORK_REQUESTED",
        "PUBLISHING",
        "PUBLISHED",
        "CI_PENDING",
        "ACCEPTED",
        "REJECTED",
        "BLOCKED",
        "ABORTED",
        "NO_CHANGE"
      ]
    }
  }
}
