{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.invalid/schemas/apap/apap-v1.schema.json",
  "title": "APAP v1 closed contracts",
  "oneOf": [
    { "$ref": "#/$defs/controlRequest" },
    { "$ref": "#/$defs/controlResponse" },
    { "$ref": "#/$defs/fdTable" },
    { "$ref": "#/$defs/signedObjectEnvelope" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "nonce": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "time": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "uint64": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "signedEpoch": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "profile": { "enum": ["qoder-cli-adr0034-v1", "codex-cli-adr0037-v1"] },
    "safeCode": {
      "enum": [
        "ok", "platform-unsupported", "profile-unsupported", "principal-unauthorized",
        "identity-mismatch", "bundle-invalid", "bundle-rollback", "evidence-invalid",
        "evidence-revoked", "evidence-expired", "host-attestation-invalid",
        "isolation-unavailable", "launch-receipt-invalid", "secret-boundary-violation",
        "provider-busy", "anchor-temporarily-unavailable", "bundle-commit-ambiguous",
        "launch-outcome-ambiguous", "internal-fail-closed"
      ]
    },
    "describeRequestPayload": { "type": "object", "properties": {}, "additionalProperties": false },
    "describeResponsePayload": {
      "type": "object",
      "required": ["providerBuildDigest", "platform", "profiles"],
      "properties": {
        "providerBuildDigest": { "$ref": "#/$defs/digest" },
        "platform": { "enum": ["linux", "darwin"] },
        "profiles": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile" }
        }
      },
      "additionalProperties": false
    },
    "beginProbeRequestPayload": {
      "type": "object",
      "required": ["candidateIdentityDigest", "suiteDigest", "probeArtifactDigest", "policyDigest", "challengeDigest", "deadline"],
      "properties": {
        "candidateIdentityDigest": { "$ref": "#/$defs/digest" },
        "suiteDigest": { "$ref": "#/$defs/digest" },
        "probeArtifactDigest": { "$ref": "#/$defs/digest" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "challengeDigest": { "$ref": "#/$defs/digest" },
        "deadline": { "$ref": "#/$defs/time" }
      },
      "additionalProperties": false
    },
    "beginProbeResponsePayload": {
      "type": "object",
      "required": ["probeSessionId", "targetIsolationIdentityDigest", "credentialIngressEndpointIdentityDigest", "expiresAt"],
      "properties": {
        "probeSessionId": { "$ref": "#/$defs/id" },
        "targetIsolationIdentityDigest": { "$ref": "#/$defs/digest" },
        "credentialIngressEndpointIdentityDigest": { "$ref": "#/$defs/digest" },
        "expiresAt": { "$ref": "#/$defs/time" }
      },
      "additionalProperties": false
    },
    "requestBase": {
      "type": "object",
      "required": ["schemaVersion", "protocolFamily", "protocolVersion", "audience", "requestId", "commandId", "callerPrincipalDigest", "providerInstanceId", "authorityProfile", "operation", "issuedAt", "expiresAt", "nonce", "expectedProviderSequence", "payload", "requestEnvelopeDigest"],
      "properties": {
        "schemaVersion": { "const": "marshal.agent-production-authority.request.v1" },
        "protocolFamily": { "const": "marshal.agent-production-authority" },
        "protocolVersion": { "const": 1 },
        "audience": { "const": "marshal.agent-production-authority.local" },
        "requestId": { "$ref": "#/$defs/id" },
        "commandId": { "$ref": "#/$defs/id" },
        "callerPrincipalDigest": { "$ref": "#/$defs/digest" },
        "providerInstanceId": { "$ref": "#/$defs/id" },
        "authorityProfile": { "$ref": "#/$defs/profile" },
        "operation": { "enum": ["Describe", "BeginProbe"] },
        "issuedAt": { "$ref": "#/$defs/time" },
        "expiresAt": { "$ref": "#/$defs/time" },
        "nonce": { "$ref": "#/$defs/nonce" },
        "expectedProviderSequence": { "oneOf": [{ "$ref": "#/$defs/uint64" }, { "type": "null" }] },
        "payload": { "type": "object" },
        "requestEnvelopeDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "controlRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestBase" },
        {
          "oneOf": [
            { "properties": { "operation": { "const": "Describe" }, "expectedProviderSequence": { "type": "null" }, "payload": { "$ref": "#/$defs/describeRequestPayload" } } },
            { "properties": { "operation": { "const": "BeginProbe" }, "expectedProviderSequence": { "$ref": "#/$defs/uint64" }, "payload": { "$ref": "#/$defs/beginProbeRequestPayload" } } }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "responseBase": {
      "type": "object",
      "required": ["schemaVersion", "protocolFamily", "protocolVersion", "audience", "requestId", "commandId", "providerInstanceId", "authorityProfile", "operation", "observedProviderSequence", "safeCode", "safeMessage", "payload", "responseEnvelopeDigest"],
      "properties": {
        "schemaVersion": { "const": "marshal.agent-production-authority.response.v1" },
        "protocolFamily": { "const": "marshal.agent-production-authority" },
        "protocolVersion": { "const": 1 },
        "audience": { "const": "marshal.agent-production-authority.local" },
        "requestId": { "$ref": "#/$defs/id" },
        "commandId": { "$ref": "#/$defs/id" },
        "providerInstanceId": { "$ref": "#/$defs/id" },
        "authorityProfile": { "$ref": "#/$defs/profile" },
        "operation": { "enum": ["Describe", "BeginProbe"] },
        "observedProviderSequence": { "$ref": "#/$defs/uint64" },
        "safeCode": { "$ref": "#/$defs/safeCode" },
        "safeMessage": { "type": "string", "maxLength": 128 },
        "payload": {},
        "responseEnvelopeDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "controlResponse": {
      "allOf": [
        { "$ref": "#/$defs/responseBase" },
        {
          "oneOf": [
            {
              "properties": { "safeCode": { "const": "ok" }, "safeMessage": { "const": "" } },
              "oneOf": [
                { "properties": { "operation": { "const": "Describe" }, "payload": { "$ref": "#/$defs/describeResponsePayload" } } },
                { "properties": { "operation": { "const": "BeginProbe" }, "payload": { "$ref": "#/$defs/beginProbeResponsePayload" } } }
              ]
            },
            {
              "properties": { "safeCode": { "not": { "const": "ok" } }, "payload": { "type": "null" } },
              "oneOf": [
                { "properties": { "safeCode": { "const": "platform-unsupported" }, "safeMessage": { "const": "request rejected: platform-unsupported" } } },
                { "properties": { "safeCode": { "const": "profile-unsupported" }, "safeMessage": { "const": "request rejected: profile-unsupported" } } },
                { "properties": { "safeCode": { "const": "principal-unauthorized" }, "safeMessage": { "const": "request rejected: principal-unauthorized" } } },
                { "properties": { "safeCode": { "const": "identity-mismatch" }, "safeMessage": { "const": "request rejected: identity-mismatch" } } },
                { "properties": { "safeCode": { "const": "bundle-invalid" }, "safeMessage": { "const": "request rejected: bundle-invalid" } } },
                { "properties": { "safeCode": { "const": "bundle-rollback" }, "safeMessage": { "const": "request rejected: bundle-rollback" } } },
                { "properties": { "safeCode": { "const": "evidence-invalid" }, "safeMessage": { "const": "request rejected: evidence-invalid" } } },
                { "properties": { "safeCode": { "const": "evidence-revoked" }, "safeMessage": { "const": "request rejected: evidence-revoked" } } },
                { "properties": { "safeCode": { "const": "evidence-expired" }, "safeMessage": { "const": "request rejected: evidence-expired" } } },
                { "properties": { "safeCode": { "const": "host-attestation-invalid" }, "safeMessage": { "const": "request rejected: host-attestation-invalid" } } },
                { "properties": { "safeCode": { "const": "isolation-unavailable" }, "safeMessage": { "const": "request rejected: isolation-unavailable" } } },
                { "properties": { "safeCode": { "const": "launch-receipt-invalid" }, "safeMessage": { "const": "request rejected: launch-receipt-invalid" } } },
                { "properties": { "safeCode": { "const": "secret-boundary-violation" }, "safeMessage": { "const": "request rejected: secret-boundary-violation" } } },
                { "properties": { "safeCode": { "const": "provider-busy" }, "safeMessage": { "const": "request rejected: provider-busy" } } },
                { "properties": { "safeCode": { "const": "anchor-temporarily-unavailable" }, "safeMessage": { "const": "request rejected: anchor-temporarily-unavailable" } } },
                { "properties": { "safeCode": { "const": "bundle-commit-ambiguous" }, "safeMessage": { "const": "request rejected: bundle-commit-ambiguous" } } },
                { "properties": { "safeCode": { "const": "launch-outcome-ambiguous" }, "safeMessage": { "const": "request rejected: launch-outcome-ambiguous" } } },
                { "properties": { "safeCode": { "const": "internal-fail-closed" }, "safeMessage": { "const": "request rejected: internal-fail-closed" } } }
              ]
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "fdDescriptor": {
      "type": "object", "required": ["role", "index", "identityDigest"],
      "properties": {
        "role": { "enum": ["candidateExecutable", "scratchRoot", "businessDenyRoot"] },
        "index": { "type": "integer", "minimum": 0, "maximum": 15 },
        "identityDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "fdTable": {
      "type": "object", "required": ["schemaVersion", "operation", "descriptors"],
      "properties": {
        "schemaVersion": { "const": "marshal.agent-production-authority.fd-table.v1" },
        "operation": { "enum": ["Describe", "BeginProbe"] },
        "descriptors": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/fdDescriptor" } }
      },
      "allOf": [
        { "if": { "properties": { "operation": { "const": "Describe" } } }, "then": { "properties": { "descriptors": { "maxItems": 0 } } } },
        { "if": { "properties": { "operation": { "const": "BeginProbe" } } }, "then": { "properties": { "descriptors": { "minItems": 3, "maxItems": 18 } } } }
      ],
      "additionalProperties": false
    },
    "signedObjectEnvelope": {
      "type": "object",
      "required": ["objectDigest", "signatureAlgorithm", "signatureEncoding", "keyId", "keyEpoch", "signatureDomain", "signature"],
      "properties": {
        "objectDigest": { "$ref": "#/$defs/digest" },
        "signatureAlgorithm": { "const": "Ed25519" },
        "signatureEncoding": { "const": "base64url-unpadded" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[ -~]+$" },
        "keyEpoch": { "$ref": "#/$defs/signedEpoch" },
        "signatureDomain": {
          "enum": [
            "marshal-credential-ingress-ticket-v1\u0000", "marshal-credential-delivery-receipt-v1\u0000",
            "marshal-credential-install-receipt-v1\u0000", "marshal-apap-launch-binding-receipt-v1\u0000",
            "marshal-agent-authority-bundle-v1\u0000", "marshal-evidence-update-authorization-v1\u0000",
            "marshal-rotation-authorization-v1\u0000", "marshal-revocation-authorization-v1\u0000",
            "marshal-bundle-prepared-receipt-v1\u0000", "marshal-anchor-advance-receipt-v1\u0000",
            "marshal-bundle-commit-receipt-v1\u0000", "marshal-bundle-recovery-receipt-v1\u0000"
          ]
        },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      },
      "additionalProperties": false
    }
  }
}
