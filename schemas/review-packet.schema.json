{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.dev/schemas/v1alpha1/review-packet.schema.json",
  "title": "Marshal ReviewPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "taskId",
    "runId",
    "reviewRound",
    "specDigest",
    "baseSha",
    "snapshotDigest",
    "diffDigest",
    "verificationDigest",
    "artifactManifestDigest",
    "workerResultDigests",
    "evidenceDigest",
    "inputs",
    "previousBlockingFindings",
    "generatedAt"
  ],
  "properties": {
    "apiVersion": { "const": "marshal.dev/v1alpha1" },
    "kind": { "const": "ReviewPacket" },
    "taskId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "reviewRound": { "type": "integer", "minimum": 1 },
    "specDigest": { "$ref": "#/$defs/digest" },
    "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "snapshotDigest": { "$ref": "#/$defs/digest" },
    "diffDigest": { "$ref": "#/$defs/digest" },
    "verificationDigest": { "$ref": "#/$defs/digest" },
    "artifactManifestDigest": { "$ref": "#/$defs/digest" },
    "workerResultDigests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/digest" }
    },
    "evidenceDigest": { "$ref": "#/$defs/digest" },
    "candidateDigest": { "$ref": "#/$defs/digest" },
    "workerCandidateDigest": { "$ref": "#/$defs/digest" },
    "codexEligibilityBinding": { "$ref": "#/$defs/codexEligibilityBinding" },
    "localSelfIdentityBinding": { "$ref": "#/$defs/localReviewBinding" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskSpec", "patch", "verificationReport", "artifactManifest"],
      "properties": {
        "taskSpec": { "$ref": "#/$defs/relativePath" },
        "patch": { "$ref": "#/$defs/relativePath" },
        "verificationReport": { "$ref": "#/$defs/relativePath" },
        "artifactManifest": { "$ref": "#/$defs/relativePath" },
        "workerResults": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "previousBlockingFindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/previousFinding" }
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "requiredOutcome": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "file": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "line": { "type": "integer", "minimum": 1 },
        "gateId": { "$ref": "#/$defs/id" },
        "artifactId": { "$ref": "#/$defs/id" }
      }
    },
    "previousFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "title", "description", "evidenceDigest", "snapshotDigest", "verificationDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "requiredOutcome": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "file": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "line": { "type": "integer", "minimum": 1 },
        "gateId": { "$ref": "#/$defs/id" },
        "artifactId": { "$ref": "#/$defs/id" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "snapshotDigest": { "$ref": "#/$defs/digest" },
        "verificationDigest": { "$ref": "#/$defs/digest" },
        "candidateDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "codexEligibilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "taskId", "runId", "attemptId", "capabilitySnapshotDigest",
        "authorityEvidenceDigest", "configDigest", "fenceDigest", "launchReceiptDigest",
        "launchAcceptTopologyDigest"
      ],
      "properties": {
        "schemaVersion": { "const": "marshal.codex.eligibility-binding.v1" },
        "taskId": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "attemptId": { "$ref": "#/$defs/id" },
        "capabilitySnapshotDigest": { "$ref": "#/$defs/digest" },
        "authorityEvidenceDigest": { "$ref": "#/$defs/digest" },
        "configDigest": { "$ref": "#/$defs/digest" },
        "fenceDigest": { "$ref": "#/$defs/digest" },
        "launchReceiptDigest": { "$ref": "#/$defs/digest" },
        "launchAcceptTopologyDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "localReviewBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "selfProfile", "activationDigest", "identitySubjectDigest", "attemptId", "reviewRound", "verificationBindingDigest", "verificationObservationDigest", "reviewObservationDigest", "applicability"],
      "properties": {
        "schemaVersion": { "const": "marshal.local-self-identity-review-binding.v2" },
        "selfProfile": { "const": "darwin-local-dogfood" },
        "activationDigest": { "$ref": "#/$defs/digest" },
        "identitySubjectDigest": { "$ref": "#/$defs/digest" },
        "attemptId": { "$ref": "#/$defs/id" },
        "reviewRound": { "type": "integer", "minimum": 1 },
        "verificationBindingDigest": { "$ref": "#/$defs/digest" },
        "verificationObservationDigest": { "$ref": "#/$defs/digest" },
        "reviewObservationDigest": { "$ref": "#/$defs/digest" },
        "applicability": { "$ref": "#/$defs/localApplicability" }
      }
    },
    "localApplicability": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "selfProfile", "activationDigest", "identitySubjectDigest", "assurance", "execution", "production", "publication"],
      "properties": {
        "schemaVersion": { "const": "marshal.local-dogfood-environment-binding.v2" }, "selfProfile": { "const": "darwin-local-dogfood" },
        "activationDigest": { "$ref": "#/$defs/digest" }, "identitySubjectDigest": { "$ref": "#/$defs/digest" },
        "assurance": { "const": "ordinary-user" }, "execution": { "const": "workspace-write" }, "production": { "const": false }, "publication": { "const": "none" }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:[\\\\/]" },
          { "pattern": "(^|/)\\.\\.(/|$)" },
          { "pattern": "\\\\" },
          { "pattern": "\\u0000" }
        ]
      }
    }
  }
}
