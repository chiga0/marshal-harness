{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.local/schemas/admission-receipt.schema.json",
  "title": "Marshal non-authoritative operator admission observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "authority", "taskId", "runId", "observationSequence",
    "stateEventSequence", "observedAt", "validUntil", "bindings", "host",
    "adapter", "worktree", "files", "planApproval", "launchEnvironment",
    "tooling", "dynamicEvidence", "checks", "decision", "reasonCode"
  ],
  "properties": {
    "format": { "const": "marshal-skill/operator-admission-receipt-v3" },
    "authority": { "const": "operator-local-non-core" },
    "taskId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "observationSequence": { "type": "integer", "minimum": 1 },
    "stateEventSequence": { "type": "integer", "minimum": 1 },
    "observedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
    "validUntil": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceHead", "baseSha", "specDigest", "policyDigest", "capabilityDigest", "runStateDigest", "planApprovalDigest"],
      "properties": {
        "sourceHead": { "$ref": "#/$defs/gitSha" },
        "baseSha": { "$ref": "#/$defs/gitSha" },
        "specDigest": { "$ref": "#/$defs/digest" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "capabilityDigest": { "$ref": "#/$defs/digest" },
        "runStateDigest": { "$ref": "#/$defs/digest" },
        "planApprovalDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "enum": ["darwin", "linux"] },
        "arch": { "enum": ["arm64", "amd64"] }
      }
    },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "mode", "binaryVersion", "executable"],
      "properties": {
        "id": { "enum": ["qoder", "codex", "qwen", "pi"] },
        "mode": { "enum": ["host-user", "ordinary-user"] },
        "binaryVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
        "executable": { "$ref": "#/$defs/executableIdentity" }
      }
    },
    "worktree": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalPath", "headSha", "statusDigest"],
      "properties": {
        "canonicalPath": { "$ref": "#/$defs/absolutePath" },
        "headSha": { "$ref": "#/$defs/gitSha" },
        "statusDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "files": {
      "type": "object", "additionalProperties": false,
      "required": ["statePath", "controlRecordsPath"],
      "properties": {
        "statePath": { "$ref": "#/$defs/relativePath" },
        "controlRecordsPath": { "$ref": "#/$defs/relativePath" }
      }
    },
    "planApproval": {
      "type": "object", "additionalProperties": false,
      "required": ["recordId", "controlSequence"],
      "properties": {
        "recordId": { "$ref": "#/$defs/id" },
        "controlSequence": { "type": "integer", "minimum": 1 }
      }
    },
    "launchEnvironment": {
      "type": "object", "additionalProperties": false,
      "required": ["keys", "digest"],
      "properties": {
        "keys": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "tooling": {
      "type": "object", "additionalProperties": false,
      "required": ["marshalExecutable", "watchScript"],
      "properties": {
        "marshalExecutable": { "$ref": "#/$defs/toolIdentity" },
        "watchScript": { "$ref": "#/$defs/toolIdentity" }
      }
    },
    "dynamicEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["doctorDigest", "capacityDigest", "providerBackpressureDigest"],
      "properties": {
        "doctorDigest": { "$ref": "#/$defs/digest" },
        "capacityDigest": { "$ref": "#/$defs/digest" },
        "providerBackpressureDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["stateReady", "currentPlanApproved", "doctorConfigured", "doctorSupported", "worktreeClean", "capacityAvailable", "providerBackpressureAbsent"],
      "properties": {
        "stateReady": { "const": true }, "currentPlanApproved": { "const": true },
        "doctorConfigured": { "const": true }, "doctorSupported": { "const": true },
        "worktreeClean": { "const": true }, "capacityAvailable": { "const": true },
        "providerBackpressureAbsent": { "const": true }
      }
    },
    "decision": { "const": "observe" },
    "reasonCode": { "const": "operator-sampled" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\\\\\x00]*$" },
    "relativePath": {
      "type": "string", "minLength": 1, "maxLength": 2048,
      "pattern": "^[^/\\\\\\x00][^\\\\\\x00]*$",
      "allOf": [{ "not": { "pattern": "(^|/)\\.{1,2}(/|$)" }}, { "not": { "pattern": "//|/$" }}]
    },
    "toolIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "device", "inode"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 0 }
      }
    },
    "executableIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalPath", "digest", "device", "inode"],
      "properties": {
        "canonicalPath": { "$ref": "#/$defs/absolutePath" },
        "digest": { "$ref": "#/$defs/digest" },
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
