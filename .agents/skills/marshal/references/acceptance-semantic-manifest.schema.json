{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.dev/operator-local/acceptance-semantic-manifest.schema.json",
  "title": "Marshal operator-local acceptance semantic preflight manifest",
  "description": "仅供 Marshal Skill plan 前本地预检；不是 marshal.dev Core 契约或权威记录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "taskSpecDigest",
    "command",
    "deliverablePath",
    "normalizer",
    "required_all",
    "required_any",
    "forbidden",
    "prompt_literals",
    "fixtures"
  ],
  "properties": {
    "manifestVersion": { "const": "marshal-operator-acceptance-preflight/v1" },
    "taskSpecDigest": { "$ref": "#/$defs/digest" },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argvDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "argvDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "deliverablePath": { "$ref": "#/$defs/relativePath" },
    "normalizer": {
      "enum": ["nfkc-casefold", "markdown-backtick-strip+nfkc-casefold"]
    },
    "required_all": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "required_any": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/nonempty" }
      }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "prompt_literals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "literal"],
        "properties": {
          "rule": { "type": "string", "pattern": "^required_all\\[[0-9]+\\]$" },
          "literal": { "$ref": "#/$defs/nonempty" }
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/positiveFixture" }
        },
        "negative": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/negativeFixture" }
        }
      }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*$"
    },
    "positiveFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "negativeFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "digest", "expectedReason"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" },
        "expectedReason": {
          "enum": ["missing-required-all", "missing-required-any", "forbidden-present"]
        }
      }
    }
  }
}
