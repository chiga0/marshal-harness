{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marshal-skill:operator-local:acceptance-semantic-manifest:v1",
  "title": "Marshal operator-local acceptance semantic preflight manifest",
  "description": "仅供 Marshal Skill plan 前本地预检；不是 marshal.dev Core 契约或权威记录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "taskSpecDigest",
    "command",
    "contentGate",
    "prompt_literals",
    "fixtures"
  ],
  "properties": {
    "manifestVersion": { "const": "marshal-operator-acceptance-preflight/v1" },
    "taskSpecDigest": { "$ref": "#/$defs/digest" },
    "command": { "$ref": "#/$defs/command" },
    "contentGate": { "$ref": "#/$defs/contentGate" },
    "prompt_literals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/promptLiteral" }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/positiveFixture" }
        },
        "negative": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/negativeFixture" }
        }
      }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/][^\\\\]*$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "timeoutSeconds",
        "required",
        "baselinePolicy",
        "maxLogBytes",
        "argvDigest",
        "tupleDigest"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "$ref": "#/$defs/relativePath" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "required": { "const": true },
        "baselinePolicy": { "enum": ["none", "on-failure", "always"] },
        "maxLogBytes": { "type": "integer", "minimum": 1024, "maximum": 1000000000 },
        "argvDigest": { "$ref": "#/$defs/digest" },
        "tupleDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "contentGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandPath",
        "deliverablePath",
        "minimumDeliverableCount",
        "normalizer",
        "minimumLineCount",
        "maximumBytes",
        "required_all",
        "required_any",
        "forbidden"
      ],
      "properties": {
        "commandPath": { "$ref": "#/$defs/relativePath" },
        "deliverablePath": { "$ref": "#/$defs/relativePath" },
        "minimumDeliverableCount": { "const": 1 },
        "normalizer": {
          "enum": ["nfkc-casefold", "markdown-backtick-strip+nfkc-casefold"]
        },
        "minimumLineCount": { "type": "integer", "minimum": 1 },
        "maximumBytes": { "type": "integer", "minimum": 1 },
        "required_all": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty" }
        },
        "required_any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/nonempty" }
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty" }
        }
      }
    },
    "promptLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "literal"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "literal": { "$ref": "#/$defs/nonempty" }
      }
    },
    "positiveFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "negativeFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "digest", "expectedReason"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" },
        "expectedReason": {
          "enum": [
            "below-minimum-line-count",
            "maximum-bytes-exceeded",
            "missing-required-all",
            "missing-required-any",
            "forbidden-present"
          ]
        }
      }
    }
  }
}
