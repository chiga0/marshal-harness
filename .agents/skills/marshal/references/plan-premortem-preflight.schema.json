{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marshal-skill:operator-local:plan-premortem-preflight:v1",
  "title": "Marshal operator-local plan pre-mortem preflight manifest",
  "description": "仅供 task plan 前的本地只读预检；不是 marshal.dev Core 契约、Run 记录或执行授权。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "runId",
    "selectedAdapter",
    "sourceHead",
    "taskSpec",
    "policySnapshot"
  ],
  "properties": {
    "apiVersion": { "const": "marshal.operator/v1alpha1" },
    "kind": { "const": "PlanPremortemPreflight" },
    "runId": { "$ref": "#/$defs/id" },
    "selectedAdapter": { "$ref": "#/$defs/id" },
    "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "taskSpec": { "$ref": "#/$defs/fileBinding" },
    "policySnapshot": { "$ref": "#/$defs/fileBinding" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relativeFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:[\\\\/]" },
          { "pattern": "(^|/)\\.\\.(/|$)" },
          { "pattern": "\\\\" },
          { "pattern": "(^|/)\\.marshal(/|$)" }
        ]
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/relativeFile" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
