  "priorProviderTranscriptEvidenceContract": "qoder-stream-json-1.2.0-v5",
  "migratesToProductionConformance": false,
  "declarationRuntimeMetadataAuthority": ["adapter.executable", "adapter.version"],
  "declarationRuntimeMetadataSource": "held-executable-identity-before-schema",
  "declarationSemanticSynthesisAllowed": false,
  "declarationIdentityBinding": ["taskId", "runId", "attemptId", "adapter.id"],
