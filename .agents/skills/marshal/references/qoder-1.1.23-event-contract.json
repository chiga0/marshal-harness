  "assistantMessageConflictDisposition": "protocol-invalid-do-not-retry",
  "assistantMessageClosedOnStopReasons": ["tool_use", "end_turn"],
  "assistantMessageCrossIdBeforeCloseDisposition": "protocol-invalid-do-not-retry",
  "toolUseNames": ["Agent", "Bash", "Edit", "Glob", "Grep", "Read", "TaskCreate", "TaskUpdate", "Write"],
  "toolNamesCaseSensitive": true,
  "toolResultContentTypes": ["string"],
  "toolResultIsErrorPresence": ["missing", "false", "true"],
  "permissionDenialSignals": {
    "toolResultMeta": {
      "requiredFields": ["id", "non_execution_kind"],
      "nonExecutionKind": "permission-rule",
      "binding": "same-event-tool-result-id"
    },
    "hardFailure": {
      "field": "tool_use_result.isHardFailure",
      "trueDisposition": "single-tool-result-only"
    }
  },
  "successfulAgentDisposition": "protocol-invalid-do-not-retry",
  "permissionMarkerWithMissingOrFalseIsError": "protocol-conflict-do-not-retry",
  "rawJsonPermissionScanningAllowed": false
