{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marshal-skill:operator-local:closure-matrix-preflight:v1",
  "title": "Marshal operator-local closure matrix preflight manifest",
  "description": "仅供 Marshal Skill 在导入 rework ReviewDecision 前做本地预检；不是 marshal.dev Core 契约或持久化权威。",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "freshness", "findings", "negativeFixtures"],
  "properties": {
    "manifestVersion": { "const": "marshal-operator-closure-matrix/v1" },
    "freshness": { "$ref": "#/$defs/freshness" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    },
    "negativeFixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/negativeFixture" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/][^\\\\]*$"
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId", "runId", "attemptId", "sourceHead", "reviewRound",
        "specDigest", "verificationDigest", "artifactManifestDigest",
        "evidenceDigest", "reviewPacketDigest", "snapshotDigest", "diffDigest",
        "candidateDigest", "fingerprintDigest"
      ],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "attemptId": { "$ref": "#/$defs/id" },
        "sourceHead": { "$ref": "#/$defs/gitSha" },
        "reviewRound": { "type": "integer", "minimum": 1 },
        "specDigest": { "$ref": "#/$defs/digest" },
        "verificationDigest": { "$ref": "#/$defs/digest" },
        "artifactManifestDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "reviewPacketDigest": { "$ref": "#/$defs/digest" },
        "snapshotDigest": { "$ref": "#/$defs/digest" },
        "diffDigest": { "$ref": "#/$defs/digest" },
        "candidateDigest": { "$ref": "#/$defs/digest" },
        "fingerprintDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": { "enum": ["source", "gate", "artifact"] },
        "locator": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["gate", "artifact"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "operator", "expected"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["equals", "contains-all", "matches-digest", "transitions-to", "returns-reason-code"] },
        "expected": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "observableDefect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observedFacts", "expectedFacts", "evidenceRefs"],
      "properties": {
        "kind": { "enum": ["behavior", "identity", "digest", "state", "protocol", "boundary", "recovery"] },
        "observedFacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedFacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "requiredOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "assertions", "verificationRefs", "negativeFixtureRefs"],
      "properties": {
        "kind": {
          "enum": [
            "identity-tuple", "digest", "config-key", "env-key", "enum-set",
            "state-transition", "reason-code", "attack-point", "crash-point",
            "observable-behavior"
          ]
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "verificationRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "negativeFixtureRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "severity", "title", "classification", "disposition",
        "domainKey", "ruleId", "subject", "location", "observableDefect",
        "requiredOutcome"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^F-[0-9a-f]{24}$" },
        "severity": { "enum": ["P0", "P1", "P2"] },
        "title": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["continuation", "closed-previous", "newly-discovered", "reviewer-omission"] },
        "disposition": { "enum": ["blocking-rework", "non-blocking", "closed-previous"] },
        "domainKey": { "$ref": "#/$defs/id" },
        "ruleId": { "$ref": "#/$defs/id" },
        "subject": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" },
        "observableDefect": { "$ref": "#/$defs/observableDefect" },
        "requiredOutcome": { "$ref": "#/$defs/requiredOutcome" }
      }
    },
    "negativeFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "digest", "expectedReasonCode", "findingId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" },
        "expectedReasonCode": { "$ref": "#/$defs/id" },
        "findingId": { "type": "string", "pattern": "^F-[0-9a-f]{24}$" }
      }
    }
  }
}
