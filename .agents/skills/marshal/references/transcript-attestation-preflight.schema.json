{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.dev/operator-local/transcript-attestation-preflight.schema.json",
  "title": "Marshal operator-local transcript attestation preflight",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "subject", "inputs"],
  "properties": {
    "apiVersion": { "const": "marshal.operator/v1alpha1" },
    "kind": { "const": "TranscriptAttestationPreflight" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceHead",
        "taskId",
        "runId",
        "attemptId",
        "adapterId",
        "binaryVersion",
        "protocolVersion",
        "eventContract",
        "permissionMode"
      ],
      "properties": {
        "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "taskId": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "attemptId": { "$ref": "#/$defs/id" },
        "adapterId": { "const": "qoder" },
        "binaryVersion": { "const": "1.1.23" },
        "protocolVersion": { "const": "1.2.0" },
        "eventContract": { "const": "qoder-stream-json-1.2.0-v6" },
        "permissionMode": { "const": "acceptEdits" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript", "transcriptMeta", "workerResult", "workerRequest", "taskSpec", "capabilitySnapshot", "profile"],
      "properties": {
        "transcript": { "$ref": "#/$defs/input" },
        "transcriptMeta": { "$ref": "#/$defs/input" },
        "workerResult": { "$ref": "#/$defs/input" },
        "workerRequest": { "$ref": "#/$defs/input" },
        "taskSpec": { "$ref": "#/$defs/input" },
        "capabilitySnapshot": { "$ref": "#/$defs/input" },
        "profile": { "$ref": "#/$defs/input" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "maxBytes"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/digest" },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    }
  }
}
