{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.dev/operator-local/transcript-attestation-preflight.schema.json",
  "title": "Marshal operator-local transcript attestation preflight",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "subject", "inputs", "policy"],
  "properties": {
    "apiVersion": { "const": "marshal.operator/v1alpha1" },
    "kind": { "const": "TranscriptAttestationPreflight" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceHead",
        "taskId",
        "runId",
        "attemptId",
        "adapterId",
        "binaryVersion",
        "protocolVersion",
        "eventContract",
        "permissionMode"
      ],
      "properties": {
        "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "taskId": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "attemptId": { "$ref": "#/$defs/id" },
        "adapterId": { "const": "qoder" },
        "binaryVersion": { "const": "1.1.23" },
        "protocolVersion": { "const": "1.2.0" },
        "eventContract": { "const": "qoder-stream-json-1.2.0-v5" },
        "permissionMode": { "const": "acceptEdits" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript", "transcriptMeta", "workerResult", "workerRequest", "taskSpec"],
      "properties": {
        "transcript": { "$ref": "#/$defs/input" },
        "transcriptMeta": { "$ref": "#/$defs/input" },
        "workerResult": { "$ref": "#/$defs/input" },
        "workerRequest": { "$ref": "#/$defs/input" },
        "taskSpec": { "$ref": "#/$defs/input" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedToolNames",
        "forbiddenToolNames",
        "forbiddenCommandWords",
        "requiredConstraintLiterals",
        "commandBindings"
      ],
      "properties": {
        "allowedToolNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/toolName" }
        },
        "forbiddenToolNames": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/toolName" }
        },
        "forbiddenCommandWords": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._+-]+$" }
        },
        "requiredConstraintLiterals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "commandBindings": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/commandBinding" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "maxBytes"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/digest" },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    },
    "toolName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "commandBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolUseId", "commandDigest", "commandId"],
      "properties": {
        "toolUseId": { "$ref": "#/$defs/id" },
        "commandDigest": { "$ref": "#/$defs/digest" },
        "commandId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
