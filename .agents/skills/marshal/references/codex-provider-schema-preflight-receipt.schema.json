{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marshal-skill:operator-local:codex-provider-schema-preflight-receipt:v1",
  "title": "Marshal operator-local Codex provider schema preflight receipt",
  "description": "仅供 Mac ordinary-user 模式在创建 Run 或调用 Provider 前做离线预检；不是 marshal.dev Core 契约、Codex 官方契约或 authority 证据。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptVersion",
    "status",
    "reasonCode",
    "adapterId",
    "cliCompatibilityLine",
    "authorityScope",
    "authorityClaim",
    "profileVersion",
    "profileDigest",
    "rulesDigest",
    "schema",
    "issueCount",
    "issues"
  ],
  "properties": {
    "receiptVersion": { "const": "marshal-operator-codex-provider-schema-preflight/v1" },
    "status": { "enum": ["pass", "fail"] },
    "reasonCode": {
      "enum": [
        "codex-provider-schema-compatible",
        "codex-provider-schema-incompatible"
      ]
    },
    "adapterId": { "const": "codex" },
    "cliCompatibilityLine": { "const": "0.145.x" },
    "authorityScope": { "const": "mac-ordinary-user-operator-local" },
    "authorityClaim": { "const": "none" },
    "profileVersion": { "const": "marshal-operator-codex-provider-schema-profile/v1" },
    "profileDigest": { "$ref": "#/$defs/digest" },
    "rulesDigest": { "$ref": "#/$defs/digest" },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawDigest", "rawBytes", "nofollow", "boundedRead"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "rawDigest": { "$ref": "#/$defs/digest" },
        "rawBytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "nofollow": { "const": true },
        "boundedRead": { "const": true }
      }
    },
    "issueCount": { "type": "integer", "minimum": 0 },
    "issues": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reasonCode": { "const": "codex-provider-schema-compatible" },
          "issueCount": { "const": 0 },
          "issues": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "reasonCode": { "const": "codex-provider-schema-incompatible" },
          "issueCount": { "minimum": 1 },
          "issues": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "pattern": "^(?:[^/\\\\]+/)*[^/\\\\]+$" },
        { "not": { "pattern": "(^|/)(?:\\.|\\.\\.)(/|$)" } }
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "jsonPointer", "keyword"],
      "properties": {
        "code": {
          "enum": [
            "additional-properties-not-false",
            "anyof-shape-invalid",
            "array-items-missing",
            "enum-shape-invalid",
            "keyword-value-invalid",
            "missing-type",
            "object-properties-invalid",
            "required-properties-mismatch",
            "type-invalid",
            "unknown-keyword",
            "unsupported-keyword"
          ]
        },
        "jsonPointer": { "type": "string", "pattern": "^/(?:[^~]|~[01])*(?:/(?:[^~]|~[01])*)*$|^$" },
        "keyword": { "type": "string" }
      }
    }
  }
}
