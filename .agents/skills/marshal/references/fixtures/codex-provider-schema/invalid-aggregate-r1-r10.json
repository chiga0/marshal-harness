{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "model": { "type": "string" }
      },
      "required": ["id"]
    },
    "apiVersion": {
      "const": "marshal.dev/v1alpha1"
    },
    "declaredArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["uri"],
        "oneOf": [
          { "type": "object", "additionalProperties": false, "properties": {}, "required": [] }
        ]
      }
    },
    "declaredChangedFiles": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "required": [
    "adapter",
    "apiVersion",
    "declaredArtifacts",
    "declaredChangedFiles"
  ],
  "not": {
    "anyOf": [
      { "pattern": "^forbidden$" },
      { "type": "string" }
    ]
  }
}
