{
  "apiVersion": "marshal.dev/v1alpha1",
  "kind": "Task",
  "metadata": {
    "id": "TA-POSITIVE",
    "title": "Qoder transcript attestation fixture"
  },
  "repository": {
    "path": "/fixture/repository",
    "baseRef": "main",
    "remote": "origin"
  },
  "work": {
    "objective": "创建一份固定报告，并使用受控 WorkerResult transport 声明结果。",
    "constraints": [
      "WorkerResult final tee 必须是最后一个 tool call，成功后立即 end_turn。",
      "除 final tee 外没有任何开发或自测命令，因此 declaredCommands 必须为空。"
    ]
  },
  "scope": {
    "allowPaths": ["report.md"],
    "denyPaths": [".marshal/**"],
    "allowSubmodules": false,
    "maxChangedFiles": 1,
    "maxDiffBytes": 4096
  },
  "acceptance": {
    "commands": [],
    "allowNoChange": false
  },
  "deliverables": [
    {
      "id": "report",
      "kind": "report",
      "required": true,
      "pathGlob": "report.md"
    }
  ],
  "worker": {
    "preferredAdapter": "qoder",
    "fallbackAdapters": [],
    "executionProfile": "workspace-write",
    "sessionPolicy": "ephemeral",
    "tools": ["write", "bash"]
  },
  "budgets": {
    "runTimeoutSeconds": 600,
    "attemptTimeoutSeconds": 300,
    "maxAttempts": 1,
    "maxOperationalRetries": 0,
    "maxReworkRounds": 0,
    "maxOutputBytes": 1048576
  },
  "publication": {
    "required": false,
    "provider": "none",
    "mode": "none",
    "remote": "origin",
    "baseBranch": "main",
    "mergePolicy": "never"
  }
}
