{
  "apiVersion": "marshal.dev/v1alpha1",
  "kind": "Task",
  "metadata": { "id": "TASK-closure", "title": "验证 closure matrix preflight" },
  "repository": { "path": "/tmp/closure-fixture", "baseRef": "main", "remote": "origin" },
  "work": {
    "objective": "验证 rework finding 的封闭性。",
    "context": ["fixture 仅用于 operator-local preflight 测试。"],
    "nonGoals": ["不发布变更。"],
    "constraints": ["不修改 Core lifecycle。"]
  },
  "scope": {
    "allowPaths": ["internal/example.go"],
    "denyPaths": [],
    "allowSubmodules": false,
    "maxChangedFiles": 2,
    "maxDiffBytes": 4096
  },
  "acceptance": {
    "commands": [
      {
        "id": "closure-test",
        "argv": ["go", "test", "./internal/example"],
        "cwd": ".",
        "timeoutSeconds": 60,
        "required": true,
        "baselinePolicy": "none",
        "maxLogBytes": 4096
      }
    ],
    "allowNoChange": false
  },
  "deliverables": [
    { "id": "implementation", "kind": "code", "required": true, "pathGlob": "internal/example.go" }
  ],
  "worker": {
    "preferredAdapter": "qoder",
    "fallbackAdapters": [],
    "executionProfile": "workspace-write",
    "sessionPolicy": "ephemeral",
    "tools": ["read", "edit", "write"]
  },
  "budgets": {
    "runTimeoutSeconds": 600,
    "attemptTimeoutSeconds": 300,
    "maxAttempts": 2,
    "maxOperationalRetries": 0,
    "maxReworkRounds": 1,
    "maxOutputBytes": 100000
  },
  "publication": {
    "required": false,
    "provider": "github",
    "mode": "draft",
    "remote": "origin",
    "baseBranch": "main",
    "mergePolicy": "never",
    "requiredChecks": []
  }
}
