{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marshal.local/schemas/review-freshness-history.schema.json",
  "title": "Marshal operator-local atomic review action history",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "claims"],
  "properties": {
    "apiVersion": { "const": "marshal.operator/v1alpha1" },
    "kind": { "const": "ReviewFreshnessHistory" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "reasonCode", "dedupeKey", "freshnessFingerprint", "previousHistoryRawDigest"],
        "properties": {
          "action": { "enum": ["generate-review-packet", "dispatch-reviewer"] },
          "reasonCode": { "enum": ["packet-missing-generation-claimed", "fresh-review-packet-claimed"] },
          "dedupeKey": { "$ref": "#/$defs/digest" },
          "freshnessFingerprint": { "$ref": "#/$defs/digest" },
          "previousHistoryRawDigest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
